<Project>
  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Single source of the version (overridden by the release workflow with -p:Version=x.y.z). -->
    <Version>4.0.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <Authors>DevElkami</Authors>
    <Copyright>DevElkami - 2026</Copyright>
    <PackageProjectUrl>https://github.com/DevElkami/PasswordVault</PackageProjectUrl>

    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
</Project>
