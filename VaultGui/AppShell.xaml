<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:VaultGui.Views"
       x:Class="VaultGui.AppShell"
       FlyoutBehavior="Disabled"
       Shell.TabBarIsVisible="False"
       Title="{StaticResource AppTitle}">

    <!-- Top-level screens (absolute routes "//setup", "//unlock", "//vault"). -->
    <ShellContent x:Name="SetupItem" Route="setup" ContentTemplate="{DataTemplate views:SetupPage}" />
    <ShellContent x:Name="UnlockItem" Route="unlock" ContentTemplate="{DataTemplate views:UnlockPage}" />
    <ShellContent x:Name="VaultItem" Route="vault" ContentTemplate="{DataTemplate views:VaultPage}" />
</Shell>
